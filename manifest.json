{
  "manifest_version": 3,
  "name": "EngageIQ",
  "version": "1.1.0",
  "description": "EngageIQ Chrome Extension to enhance LinkedIn interactions.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["js/content_script.js"],
      "css": ["css/content_style.css"],
      "type": "module"
    }
  ],
  "options_page": "html/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "html/popup.html",
        "js/popup.js",
        "js/models/*.js",
        "js/services/*.js",
        "js/ui/*.js",
        "js/utils/*.js",
        "css/*.css",
        "assets/css/*.css",
        "assets/js/*.js",
        "icons/*.png"
      ],
      "matches": ["*://*.linkedin.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
