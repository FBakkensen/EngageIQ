{
  "manifest_version": 3,
  "name": "EngageIQ",
  "version": "0.1.0",
  "description": "EngageIQ Chrome Extension to enhance LinkedIn interactions.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["js/content_script.js"],
      "css": ["css/content_style.css"]
    }
  ],
  "options_page": "html/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "html/popup.html",
        "js/popup.js",
        "css/popup.css",
        "assets/css/bootstrap.min.css",
        "assets/js/bootstrap.bundle.min.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["*://*.linkedin.com/*"]
    }
  ]
}
