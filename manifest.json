{
  "manifest_version": 3,
  "name": "EngageIQ",
  "version": "1.0.0",
  "description": "EngageIQ Chrome Extension to enhance LinkedIn interactions.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["js/content_script.js"],
      "css": ["css/content_style.css"],
      "type": "module"
    }
  ],
  "options_page": "html/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "html/popup.html",
        "html/manifest_check.html",
        "js/popup.js",
        "js/manifest_check.js",
        "js/models/gemini-model.js",
        "js/services/api-service.js",
        "js/services/comment-generation.js",
        "js/services/regeneration-service.js",
        "js/services/post-extractor.js",
        "js/services/message-service.js",
        "js/ui/button-injector.js",
        "js/ui/iframe-manager.js",
        "js/ui/suggestion-renderer.js",
        "js/ui/error-handler.js",
        "js/ui/accordion-controller.js",
        "js/utils/storage-utils.js",
        "css/popup.css",
        "css/options.css",
        "assets/css/bootstrap.min.css",
        "assets/js/bootstrap.bundle.min.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["*://*.linkedin.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
